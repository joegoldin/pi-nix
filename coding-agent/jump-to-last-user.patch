+import assert from "node:assert/strict";
+import { it } from "node:test";
+import { ScrollView } from "../src/components/scroll-view.ts";
+import { Text } from "../src/components/text.ts";
+import { TuiAltScreen } from "../src/tui-alt-screen.ts";
+import { VirtualTerminal } from "./virtual-terminal.ts";
+
+const prompt = "\x1b]133;A;pi=user\x07";
+const label = " Jump to last user message ";
+
+it("jumps to the most recent user prompt, not the first, without following new output", async () => {
+	const terminal = new VirtualTerminal(60, 6);
+	const tui = new TuiAltScreen(terminal, undefined, undefined, {
+		scrollToLastPromptIndicator: () => label,
+		scrollToEndIndicator: () => " Jump to latest message ",
+	});
+	const lines = [
+		`${prompt}first user`,
+		"\x1b]133;A\x07old answer",
+		`${prompt}last user`,
+		"\x1b]133;A\x07assistant reply",
+		...Array.from({ length: 20 }, (_, i) => `answer ${i}`),
+	];
+	const text = new Text(lines.join("\n"), 0, 0);
+	const transcript = new ScrollView(text, { follow: "end", primary: true });
+	tui.setLayoutRoot(transcript);
+	tui.start();
+	try {
+		await terminal.waitForRender();
+		assert.ok(terminal.getViewport()[0].includes(label));
+		terminal.sendInput("\x1b[<0;30;1M");
+		terminal.sendInput("\x1b[<0;30;1m");
+		await terminal.waitForRender();
+		assert.equal(transcript.scrollTop, 2);
+		assert.equal(transcript.isFollowingEnd, false);
+		assert.ok(terminal.getViewport()[0].includes("last user"));
+		assert.ok(!terminal.getViewport()[0].includes(label));
+		assert.ok(terminal.getViewport()[5].includes("Jump to latest message"));
+		text.setText([...lines, "more streaming output"].join("\n"));
+		tui.requestRender();
+		await terminal.waitForRender();
+		assert.equal(transcript.scrollTop, 2);
+	} finally {
+		tui.stop();
+	}
+});
+
+it("has no jump control without a prompt and clears stale targets after transcript replacement", async () => {
+	const terminal = new VirtualTerminal(60, 6);
+	const tui = new TuiAltScreen(terminal, undefined, undefined, { scrollToLastPromptIndicator: () => label });
+	const text = new Text(`${prompt}user\n${"answer\n".repeat(20)}`, 0, 0);
+	const transcript = new ScrollView(text, { follow: "end", primary: true });
+	tui.setLayoutRoot(transcript);
+	tui.start();
+	try {
+		await terminal.waitForRender();
+		assert.ok(terminal.getViewport()[0].includes(label));
+		text.setText("new session\nno user messages");
+		tui.requestRender();
+		await terminal.waitForRender();
+		assert.ok(!terminal.getViewport().some((line) => line.includes(label)));
+		terminal.sendInput("\x1b[<0;30;1M");
+		terminal.sendInput("\x1b[<0;30;1m");
+		await terminal.waitForRender();
+		assert.equal(transcript.scrollTop, 0);
+	} finally {
+		tui.stop();
+	}
+});
+
+it("walks backward through user prompts when scrolling above the newest, including after resize", async () => {
+	const terminal = new VirtualTerminal(60, 6);
+	const tui = new TuiAltScreen(terminal, undefined, undefined, {
+		scrollToLastPromptIndicator: (direction) => {
+			assert.equal(direction, -1);
+			return label;
+		},
+	});
+	const lines = [
+		`${prompt}first`, ...Array(10).fill("first answer"),
+		`${prompt}middle`, ...Array(10).fill("middle answer"),
+		`${prompt}latest`, ...Array(20).fill("latest answer"),
+	];
+	const transcript = new ScrollView(new Text(lines.join("\n"), 0, 0), {
+		follow: "end", primary: true, scrollbar: "always",
+	});
+	tui.setLayoutRoot(transcript);
+	tui.start();
+	const click = async (column: number) => {
+		terminal.sendInput(`\x1b[<0;${column};1M`);
+		terminal.sendInput(`\x1b[<0;${column};1m`);
+		await terminal.waitForRender();
+	};
+	try {
+		await terminal.waitForRender();
+		await click(30);
+		assert.equal(transcript.scrollTop, 22);
+		assert.ok(terminal.getViewport()[0].includes("latest"));
+		// The newest prompt is still visible below the top, but the jump now leads backward.
+		transcript.scrollTo(21, { disableFollow: true });
+		tui.requestRender();
+		await terminal.waitForRender();
+		assert.ok(terminal.getViewport()[0].includes(label));
+		await click(30);
+		assert.equal(transcript.scrollTop, 11);
+		assert.ok(terminal.getViewport()[0].includes("middle"));
+		transcript.scrollTo(10, { disableFollow: true });
+		tui.requestRender();
+		await terminal.waitForRender();
+		terminal.resize(20, 5);
+		await terminal.waitForRender();
+		assert.ok(terminal.getViewport()[0].includes("Jump to last"));
+		await click(10);
+		assert.equal(transcript.scrollTop, 0);
+		assert.equal(transcript.isFollowingEnd, false);
+		assert.ok(terminal.getViewport()[0].includes("first"));
+		assert.ok(!terminal.getViewport().some((line) => line.includes("Jump to last")));
+	} finally {
+		tui.stop();
+	}
+});
+
+it("renders the user message rather than stopping at an assistant message zone", async () => {
+	const { UserMessageComponent } = await import("../../coding-agent/src/modes/interactive/components/user-message.ts");
+	const { AssistantMessageComponent } = await import("../../coding-agent/src/modes/interactive/components/assistant-message.ts");
+	const { initTheme } = await import("../../coding-agent/src/modes/interactive/theme/theme.ts");
+	const { Container } = await import("../src/tui.ts");
+	initTheme("dark");
+	const terminal = new VirtualTerminal(60, 6);
+	const tui = new TuiAltScreen(terminal, undefined, undefined, { scrollToLastPromptIndicator: () => label });
+	const content = new Container();
+	content.addChild(new UserMessageComponent("first user"));
+	content.addChild(new Text("old answer", 0, 0));
+	const targetRow = content.render(60).length;
+	content.addChild(new UserMessageComponent("last user\n\nsecond line"));
+	// A completed assistant reply emits OSC 133;A too, unlike the old plain-text fixture.
+	const assistant = new AssistantMessageComponent();
+	assistant.addChild(new Text("assistant answer\n".repeat(20), 0, 0));
+	content.addChild(assistant);
+	const transcript = new ScrollView(content, { follow: "end", primary: true });
+	tui.setLayoutRoot(transcript);
+	tui.start();
+	try {
+		await terminal.waitForRender();
+		terminal.sendInput("\x1b[<0;30;1M");
+		terminal.sendInput("\x1b[<0;30;1m");
+		await terminal.waitForRender();
+		assert.equal(transcript.scrollTop, targetRow);
+		assert.equal(transcript.isFollowingEnd, false);
+		assert.ok(terminal.getViewport().some((line) => line.includes("last user")));
+		assert.ok(terminal.getViewport().some((line) => line.includes("second line")));
+	} finally {
+		tui.stop();
+	}
+});
