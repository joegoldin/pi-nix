+	/** Locate the actual component at its current rendered width, not a saved row number. */
+	scrollToComponent(target: Component): boolean {
+		const view = this.getPrimaryScrollView();
+		if (!this.currentLayout) return false;
+		const box = getScrollViewBox(this.currentLayout, view);
+		if (!box) return false;
+		const width = view.getContentWidth(box.rect.width);
+		const locate = (component: Component): number | undefined => {
+			if (component === target) return 0;
+			// Plain containers concatenate children; custom renderers may not.
+			if (!(component instanceof Container) || component.render !== Container.prototype.render) return undefined;
+			let offset = 0, lastVisible = 0;
+			for (const child of component.children) {
+				const found = locate(child);
+				const height = child.render(width).length;
+				if (found !== undefined) return height === 0 ? lastVisible : offset + found;
+				if (height > 0) lastVisible = offset;
+				offset += height;
+			}
+			return undefined;
+		};
+		const content = box.children[0]?.component;
+		const offset = content && locate(content);
+		if (offset === undefined) return false;
+		view.scrollTo(offset, { disableFollow: true });
+		this.requestRender();
