--- a/src/lib.rs
+++ b/src/lib.rs
@@ -26,7 +26,9 @@
 pub fn convert_lockfile_to_nix_expression(contents: String, options: Options) -> Result<String> {
     let lockfile = contents.parse::<Lockfile>()?;
 
-    if lockfile.lockfile_version != 1 {
+    // v3 changes override resolution, which Bun has already recorded in the
+    // package tuples. This converter fetches those tuples, not the overrides.
+    if !matches!(lockfile.lockfile_version, 1 | 3) {
         return Err(Error::UnsupportedLockfileVersion(lockfile.lockfile_version));
     };
 
@@ -36,3 +38,30 @@
 
     NixExpression::new(packages)?.render_with_options(options)
 }
+
+#[cfg(test)]
+mod lock_version_tests {
+    use super::*;
+
+    fn options() -> Options {
+        Options { copy_prefix: String::new() }
+    }
+
+    #[test]
+    fn v3_resolved_packages_match_v1_despite_nested_overrides() {
+        let v1 = r#"{"lockfileVersion":1,"packages":{"undici":["undici@7.30.1","",{},"sha512-03KrMbjIFDWQR5RNPrSw3bd1r12JpyFQl9/yxjUbJtqkjmllqC5lFjZh6ujeuJCKr8EOQvRW872Oy/az+nLYxg=="]}}"#;
+        let v3 = v1.replace("\"lockfileVersion\":1", "\"lockfileVersion\":3,\"overrides\":{\"miniflare\":{\"undici\":\"7.30.1\"}}");
+        assert_eq!(
+            convert_lockfile_to_nix_expression(v1.into(), options()).unwrap(),
+            convert_lockfile_to_nix_expression(v3, options()).unwrap()
+        );
+    }
+
+    #[test]
+    fn untested_future_lock_versions_still_fail() {
+        let result = convert_lockfile_to_nix_expression(
+            r#"{"lockfileVersion":4,"packages":{}}"#.into(), options()
+        );
+        assert!(matches!(result, Err(Error::UnsupportedLockfileVersion(4))));
+    }
+}
